# API
API_CONSOLE_PORT=5281
API_CONSOLE_CORS_ORIGIN=http://localhost:5280
API_CONSOLE_DATA_DIR=runtime/api-console
API_CONSOLE_STORE_FILE=
# FILE (default) | SQLITE | POSTGRES — SQLITE requires Node 22+; POSTGRES requires Prisma + DATABASE_URL
API_CONSOLE_STORE_BACKEND=FILE
API_CONSOLE_SQLITE_FILE=runtime/api-console/api-console.sqlite
# PostgreSQL (Prisma multi-schema). Used when API_CONSOLE_STORE_BACKEND=POSTGRES
DATABASE_URL=postgresql://postgres:1234@localhost:5432/API-CONSOLE?schema=public
API_CONSOLE_SECRET_VAULT_FILE=
API_CONSOLE_SECRET_KEY_FILE=
API_CONSOLE_SECRET_KEY=
API_CONSOLE_DOCX_TEMPLATE_FILE=
API_CONSOLE_MAX_REQUEST_BODY=
API_CONSOLE_MAX_RESPONSE_BODY=
API_CONSOLE_MAX_REDIRECTS=
API_CONSOLE_CONNECT_TIMEOUT_MS=
API_CONSOLE_READ_TIMEOUT_MS=
API_CONSOLE_TOTAL_TIMEOUT_MS=
# Large response body object store (S01.03). Default: <API_CONSOLE_DATA_DIR>/object-storage
API_CONSOLE_OBJECT_STORE_DIR=
# Blob TTL in days for hourly cleanup (default 7)
API_CONSOLE_OBJECT_STORE_TTL_DAYS=7
# Optional total size cap in bytes; oldest blobs deleted first when exceeded
API_CONSOLE_OBJECT_STORE_MAX_BYTES=
API_CONSOLE_ALLOW_PRIVATE_DESTINATIONS=
API_CONSOLE_PRIVATE_DESTINATION_ALLOWLIST=
# Public DNS fallback when corporate DNS remaps public hosts to private / sinkhole IPs
API_CONSOLE_DNS_SERVERS=8.8.8.8,1.1.1.1
# DNS-over-HTTPS fallback when UDP to public resolvers is blocked (comma-separated)
API_CONSOLE_DOH_URLS=https://cloudflare-dns.com/dns-query,https://dns.google/resolve
# local (AES file vault) | env (process.env / API_CONSOLE_SECRET_<REF>)
API_CONSOLE_VAULT_PROVIDER=local
# Require second elevated approver for Production Core Command execute
API_CONSOLE_DUAL_APPROVAL=false
# warn | block — secret patterns on cURL/Postman import
API_CONSOLE_SECRET_SCAN_MODE=warn
# Collection-run result webhook (E19)
API_CONSOLE_RUN_WEBHOOK_URL=
API_CONSOLE_RUN_WEBHOOK_SECRET=
# ITSM webhook on share approve/return (E27)
API_CONSOLE_ITSM_WEBHOOK_URL=
API_CONSOLE_ITSM_WEBHOOK_SECRET=
# Comma-separated host allowlist for ticketUrl (optional)
API_CONSOLE_ITSM_URL_ALLOWLIST=
# When true, executeRequest enqueues to store.executionQueue (requires zone-worker)
API_CONSOLE_ZONE_WORKER=false
API_CONSOLE_ZONE_WORKER_WAIT_MS=15000
API_CONSOLE_ZONE_WORKER_POLL_MS=1500
# Optional override for execution.runnerHost tagging
API_CONSOLE_RUNNER_HOST=

# App session (replaces UTMS auth)
API_CONSOLE_SESSION_COOKIE=api_console_session
API_CONSOLE_CSRF_SECRET=change-me-api-console-csrf-secret-32chars
# In NODE_ENV=production, secrets containing "change-me" or shorter than 32 chars are rejected.
# Set real values for CSRF, CDE_SESSION_ENCRYPTION_KEY, RUNTIME_SESSION_ENCRYPTION_KEY, and API_CONSOLE_SECRET_KEY.
# Check: GET /api/api-console/health/config → { ok, issues } (no secret values).
API_CONSOLE_SESSION_TTL_SECONDS=43200
# Comma-separated CDE cellphone logins that bootstrap as SYSTEM_ADMIN (normalized: 0902… ≡ 902…)
API_CONSOLE_ADMIN_LOGINS=09022849799
API_CONSOLE_QA_LEAD_LOGINS=
# Opt-in only for local tests. Never set in production.
API_CONSOLE_ALLOW_LEGACY_CONTEXT=

# Workspace access gate — comma-separated CDE project keys required for console access
API_CONSOLE_REQUIRED_WORKSPACES=medu-ai
# GATE_ONLY (default): membership required to enter; all projects visible | RESTRICT: only allowlisted workspaces visible
API_CONSOLE_WORKSPACE_ALLOWLIST_MODE=GATE_ONLY

# CDE SSO (same-site cookie forward). Deploy console under *.edus.ir for automatic login.
# On localhost use phone/password — browser cookies from cde.edus.ir are not sent here.
# COOKIE_FORWARD (default) | OFF
API_CONSOLE_CDE_SSO_MODE=COOKIE_FORWARD
# Cookie names to forward: * = all except api_console_* (recommended)
API_CONSOLE_CDE_SSO_COOKIE_NAMES=*
# Public URL when the console is deployed (optional; enables Secure cookies if https://)
# API_CONSOLE_PUBLIC_URL=https://api-console.edus.ir
# Force Secure on session cookie (also auto when PUBLIC_URL/CORS is https://)
# API_CONSOLE_COOKIE_SECURE=true

# Integrated Systems (IS) — DEFERRED after v1 go-live. Default OFF (opt-in only).
# Login UI ships CDE + Local only. Do not enable until product is under load.
API_CONSOLE_IS_ENABLED=false
# API_CONSOLE_IS_GATEWAY_URL=http://127.0.0.1:4000
# API_CONSOLE_IS_SESSION_COOKIE=_lsr
# API_CONSOLE_IS_SPECS_ROOT=D:/AllApp/IS/integrated-systems/specs/medu-apps,D:/AllApp/IS/integrated-systems/specs/edus-apps
# API_CONSOLE_IS_AUTO_ENSURE_ACCESS_RULES=true
# API_CONSOLE_IS_SYSTEMS=custom-svc|Custom Service

# CDE bridge
CDE_CORE_BASE_URL=https://cde.edus.ir
# Optional multi-origin control plane (JSON array). When set, login shows an origin picker.
# API_CONSOLE_CDE_ORIGINS=[{"id":"default","label":"Default CDE","baseUrl":"https://cde.edus.ir"}]
CDE_SESSION_ENCRYPTION_KEY=change-me-api-console-cde-session-key-32
CDE_SESSION_TTL_SECONDS=43200
CDE_SESSION_REDIS_PREFIX=api-console:cde-session:
CDE_MAX_BODY_BYTES=
CDE_REQUEST_TIMEOUT_MS=
REDIS_URL=redis://127.0.0.1:6379

# Project runtimes (separate from the CDE control-plane session)
# One default Development Profile is provisioned per project for every origin below.
RUNTIME_DEFAULT_ORIGINS=https://soha.m.edus.ir
RUNTIME_ORIGIN_ALLOWLIST=*.m.edus.ir,*.medu.ir
RUNTIME_SESSION_ENCRYPTION_KEY=change-me-api-console-runtime-session-key-32
RUNTIME_SESSION_TTL_SECONDS=7200
RUNTIME_SESSION_REDIS_PREFIX=api-console:runtime-session:
RUNTIME_MAX_BODY_BYTES=33554432
RUNTIME_REQUEST_TIMEOUT_MS=60000

# Web
VITE_API_CONSOLE_BASE_URL=/api/api-console
# Optional. Prefer leaving unset so Vite uses runtime/api-console/dev-ports.json
# when API_CONSOLE_PORT is busy and the backend binds 5282+.
# VITE_DEV_API_PROXY_TARGET=http://localhost:5281
VITE_RUNTIME_DEFAULT_ORIGIN=https://soha.m.edus.ir
WEB_PORT=5280
NODE_ENV=development
