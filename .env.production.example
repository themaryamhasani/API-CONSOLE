# =============================================================================
# API Console — Production (v1 delivery: CDE + Local Directory ONLY)
# Integrated Systems (IS) is deferred until after go-live under load.
# =============================================================================
# cp .env.production.example .env.production
# Then replace every REPLACE_ME_* value (min 32 chars, no "change-me").
#
# Split build / run (see docs/deploy/LAUNCH.md):
#   Build host: npm run docker:build && npm run images:save
#   Run host:   set DATABASE_URL to external Postgres; npm run images:load && npm run compose:up
#
# Image tags (optional overrides for docker build + run compose):
#   API_IMAGE=api-console-api:latest
#   WEB_IMAGE=api-console-web:latest
# Build: docker build -f docker/Dockerfile.api|web  (npm run docker:build)
# Run:   docker-compose.yml (redis + api + web; no Postgres, no build)

NODE_ENV=production

# --- Public URLs (same registrable domain as CDE for SSO cookie-forward) ---
API_CONSOLE_PUBLIC_URL=https://api-console.edus.ir
API_CONSOLE_CORS_ORIGIN=https://api-console.edus.ir
API_CONSOLE_COOKIE_SECURE=true
WEB_PUBLISH_PORT=8080

# --- Optional image tags used by docker:build + docker-compose.yml ---
API_IMAGE=api-console-api:latest
WEB_IMAGE=api-console-web:latest

# --- External Postgres (NOT in docker-compose.yml) ---
# Must be reachable from the API container network on the RUN host.
# Entrypoint waits + migrates on boot. Do not use the placeholder host in production.
API_CONSOLE_STORE_BACKEND=POSTGRES
DATABASE_URL=postgresql://USER:PASSWORD@postgres-host:5432/api_console?schema=public

# --- Redis (compose service name "redis" on the RUN host) ---
# docker-compose.yml sets REDIS_URL to redis://redis:6379 for the api container.
# For host/local runs outside compose, use localhost / published port instead.
REDIS_URL=redis://redis:6379

# --- API process ---
API_CONSOLE_PORT=5281
API_CONSOLE_DATA_DIR=/app/runtime/api-console
API_CONSOLE_VAULT_PROVIDER=local

# --- Secrets (required on RUN host; rejected if missing / short / contain change-me) ---
API_CONSOLE_CSRF_SECRET=REPLACE_ME_CSRF_SECRET_AT_LEAST_32_CHARS
API_CONSOLE_SECRET_KEY=REPLACE_ME_VAULT_KEY_AT_LEAST_32_CHARS__
CDE_SESSION_ENCRYPTION_KEY=REPLACE_ME_CDE_SESSION_KEY_32_CHARS_
RUNTIME_SESSION_ENCRYPTION_KEY=REPLACE_ME_RUNTIME_SESSION_KEY_32_

# --- Identity / access (v1) ---
API_CONSOLE_ADMIN_LOGINS=09022849799
API_CONSOLE_QA_LEAD_LOGINS=
API_CONSOLE_REQUIRED_WORKSPACES=medu-ai
API_CONSOLE_WORKSPACE_ALLOWLIST_MODE=GATE_ONLY
API_CONSOLE_ALLOW_LEGACY_CONTEXT=
API_CONSOLE_SESSION_TTL_SECONDS=43200
API_CONSOLE_CDE_SSO_MODE=COOKIE_FORWARD
API_CONSOLE_CDE_SSO_COOKIE_NAMES=*

# --- CDE ---
CDE_CORE_BASE_URL=https://cde.edus.ir
# Optional: API_CONSOLE_CDE_ORIGINS=[{"id":"default","label":"Default CDE","baseUrl":"https://cde.edus.ir"}]
CDE_SESSION_TTL_SECONDS=43200
CDE_SESSION_REDIS_PREFIX=api-console:cde-session:

RUNTIME_DEFAULT_ORIGINS=https://soha.m.edus.ir
RUNTIME_ORIGIN_ALLOWLIST=*.m.edus.ir,*.medu.ir
RUNTIME_SESSION_TTL_SECONDS=7200
RUNTIME_SESSION_REDIS_PREFIX=api-console:runtime-session:
RUNTIME_MAX_BODY_BYTES=33554432
RUNTIME_REQUEST_TIMEOUT_MS=60000

API_CONSOLE_DNS_SERVERS=8.8.8.8,1.1.1.1
API_CONSOLE_DOH_URLS=https://cloudflare-dns.com/dns-query,https://dns.google/resolve
API_CONSOLE_DUAL_APPROVAL=false
API_CONSOLE_SECRET_SCAN_MODE=warn
API_CONSOLE_ZONE_WORKER=false

# --- v1: IS stays OFF (enable only in a later release after load) ---
API_CONSOLE_IS_ENABLED=false
# Leave gateway/specs unset in v1; do not point at localhost in production.
# API_CONSOLE_IS_GATEWAY_URL=
# API_CONSOLE_IS_SPECS_ROOT=

# --- Optional: local infra-only compose (docker-compose.infra.yml) ---
# Only if you temporarily need Postgres+Redis on this host for prod:local.
# Main production docker-compose.yml does NOT use these — Postgres stays external.
# POSTGRES_USER=apiconsole
# POSTGRES_PASSWORD=REPLACE_ME_POSTGRES_PASSWORD_32chars_min
# POSTGRES_DB=api_console
# POSTGRES_PUBLISH_PORT=15432
# REDIS_PUBLISH_PORT=16379
