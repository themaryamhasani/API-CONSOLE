{
  "name": "@api-console/api",
  "private": true,
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "node src/main.cjs",
    "test:admin": "node --test --test-force-exit --test-timeout=30000 test/admin-access.test.cjs",
    "test:session": "node --test --test-force-exit --test-timeout=30000 test/session-trust.test.cjs",
    "test:environments": "node --test --test-force-exit --test-timeout=30000 test/environments.test.cjs",
    "test:runtime": "node --test --test-timeout=30000 test/runtime-discovery.test.cjs",
    "test:phase2": "node --test --test-force-exit --test-timeout=60000 test/phase2-collab.test.cjs",
    "test:phase3": "node --test --test-force-exit --test-timeout=60000 test/phase3-platform.test.cjs",
    "test:vault": "node --test --test-force-exit --test-timeout=60000 test/vault-provider.test.cjs",
    "test:promote": "node --test --test-force-exit --test-timeout=30000 test/runtime-promote.test.cjs",
    "cli:run": "node bin/api-console-run.cjs",
    "zone-worker": "node src/modules/api-console/infrastructure/http/zone-worker.cjs",
    "migrate:db": "node bin/migrate-json-to-db.cjs",
    "migrate:pg": "node bin/migrate-store-to-postgres.cjs",
    "db:bootstrap": "node bin/bootstrap-postgres.cjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "test:persist": "node --test --test-force-exit --test-timeout=30000 test/persistence.test.cjs",
    "test:sso": "node --test --test-force-exit --test-timeout=30000 test/cde-sso.test.cjs",
    "test:workspace": "node --test --test-force-exit --test-timeout=30000 test/workspace-access.test.cjs",
    "test:postgres": "node --test --test-force-exit --test-timeout=60000 test/postgres-store.test.cjs",
    "test:system": "node --test --test-force-exit --test-timeout=60000 test/system-smoke.test.cjs",
    "test:all": "node --test --test-force-exit --test-timeout=90000 test/phase2-collab.test.cjs test/phase3-platform.test.cjs test/persistence.test.cjs test/vault-provider.test.cjs test/runtime-promote.test.cjs test/environments.test.cjs test/session-trust.test.cjs test/system-smoke.test.cjs test/admin-access.test.cjs test/cde-sso.test.cjs test/workspace-access.test.cjs",
    "self-check": "node -e \"const s=require('./src/modules/api-console/infrastructure/http/api-console-server.cjs'); s.runSelfCheck().then(r=>{console.log(JSON.stringify(r,null,2)); process.exit(r.failed?1:0);}).catch(e=>{console.error(e); process.exit(1);})\"",
    "build": "node -e \"const s=require('./src/modules/api-console/infrastructure/http/api-console-server.cjs'); if (!s.createServer) process.exit(1);\""
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "acorn": "^8.15.0",
    "acorn-jsx": "^5.3.2",
    "acorn-loose": "^8.5.2",
    "crypto-js": "^4.2.0",
    "ioredis": "^5.8.2",
    "pg": "^8.16.3",
    "swagger-ui-dist": "^5.27.1",
    "tough-cookie": "^6.0.0"
  },
  "devDependencies": {
    "prisma": "^6.16.2"
  }
}
