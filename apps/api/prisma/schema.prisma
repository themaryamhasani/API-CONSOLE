// ─── observability ───────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id
  originId    String?  @map("origin_id")
  eventType   String   @map("event_type")
  actorUserId String?  @map("actor_user_id")
  actorRole   String?  @map("actor_role")
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  extra       Json?

  @@index([createdAt(sort: Desc)])
  @@index([originId])
  @@index([actorUserId])
  @@map("audit_log")
  @@schema("observability")
}

model UsageEvent {
  id              String   @id
  originId        String?  @map("origin_id")
  eventType       String   @map("event_type")
  userId          String?  @map("user_id")
  userDisplayName String?  @map("user_display_name")
  activeRole      String?  @map("active_role")
  applicationId   String?  @map("application_id")
  apiId           String?  @map("api_id")
  apiTitle        String?  @map("api_title")
  version         String?
  referenceId     String?  @map("reference_id")
  eventAt         DateTime @default(now()) @map("event_at") @db.Timestamptz
  environmentId   String?  @map("environment_id")
  correlationId   String?  @map("correlation_id")
  extra           Json?

  @@index([applicationId])
  @@index([eventAt(sort: Desc)])
  @@map("usage_events")
  @@schema("observability")
}

model Notification {
  id             String    @id
  originId       String?   @map("origin_id")
  userId         String?   @map("user_id")
  title          String?
  message        String?
  type           String?
  entityType     String?   @map("entity_type")
  entityId       String?   @map("entity_id")
  channels       Json?
  deliveryStatus String?   @map("delivery_status")
  correlationId  String?   @map("correlation_id")
  isRead         Boolean   @default(false) @map("is_read")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  readAt         DateTime? @map("read_at") @db.Timestamptz
  extra          Json?

  user DirectoryUser? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, isRead])
  @@index([createdAt(sort: Desc)])
  @@map("notifications")
  @@schema("observability")
}
