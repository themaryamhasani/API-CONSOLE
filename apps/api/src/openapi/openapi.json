    "/api/api-console/curl/parse": {
      "post": {
        "summary": "Parse cURL into a normalized request (ds/fr aware)",
        "description": "Detects CORE_QUERY from get-data-source (ds/) and CORE_COMMAND from store-form-data (fr/). Requires CDE login session.",
        "tags": [
          "api-console"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CurlParseRequest" },
              "examples": {
                "ds-community-list": {
                  "summary": "ds/community/list",
                  "value": {
                    "curlText": "curl -X POST 'https://soha.m.edus.ir/core-api/v1/data-provider/get-data-source' -H 'Content-Type: application/json' --data-raw '{\"serviceId\":\"YOUR_PROJECT_SERVICE_ID\",\"key\":\"community/list\",\"params\":{\"page\":1}}'"
                  }
                },
                "fr-community-save": {
                  "summary": "fr/community/save",
                  "value": {
                    "curlText": "curl -X POST 'https://soha.m.edus.ir/core-api/v1/data-provider/store-form-data' -H 'Content-Type: application/json' --data-raw '{\"serviceId\":\"YOUR_PROJECT_SERVICE_ID\",\"formId\":\"community/save\",\"data\":{\"title\":\"example\"}}'"
                  }
                },
                "ds-who-am-i": {
                  "summary": "pages-app/who-am-i sanity query",
                  "value": {
                    "curlText": "curl -X POST 'https://soha.m.edus.ir/core-api/v1/data-provider/get-data-source' -H 'Content-Type: application/json' --data-raw '{\"serviceId\":\"YOUR_RUNTIME_SERVICE_ID\",\"key\":\"pages-app/who-am-i\",\"params\":{}}'"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Parsed request with classification and optional secretScan warnings"
          },
          "401": {
            "description": "CDE login required"
          }
        }
      }
    },
