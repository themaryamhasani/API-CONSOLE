    "/api/api-console/validate-core": {
      "post": {
        "summary": "Validate a Core ds/fr request shape",
        "description": "Checks CORE_QUERY (ds/) and CORE_COMMAND (fr/) payloads without calling Runtime.",
        "tags": [
          "api-console"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ValidateCoreRequest" },
              "examples": {
                "ds-community-list": {
                  "summary": "ds/community/list (CORE_QUERY)",
                  "value": {
                    "request": {
                      "method": "POST",
                      "url": "https://soha.m.edus.ir/core-api/v1/data-provider/get-data-source",
                      "body": {
                        "type": "json",
                        "value": {
                          "serviceId": "YOUR_PROJECT_SERVICE_ID",
                          "key": "community/list",
                          "params": { "page": 1 }
                        }
                      },
                      "tls": { "verifyCertificate": true }
                    }
                  }
                },
                "fr-community-save": {
                  "summary": "fr/community/save (CORE_COMMAND)",
                  "value": {
                    "request": {
                      "method": "POST",
                      "url": "https://soha.m.edus.ir/core-api/v1/data-provider/store-form-data",
                      "body": {
                        "type": "json",
                        "value": {
                          "serviceId": "YOUR_PROJECT_SERVICE_ID",
                          "formId": "community/save",
                          "data": { "title": "example" }
                        }
                      },
                      "tls": { "verifyCertificate": true }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation result with valid/errors/warnings"
          }
        }
      }
    },
