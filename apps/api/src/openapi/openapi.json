  "components": {
    "schemas": {
      "CurlParseRequest": {
        "type": "object",
        "required": ["curlText"],
        "properties": {
          "curlText": { "type": "string", "description": "Raw cURL command text" },
          "originalCurl": { "type": "string", "description": "Alias for curlText" }
        }
      },
      "ValidateCoreRequest": {
        "type": "object",
        "required": ["request"],
        "properties": {
          "request": {
            "type": "object",
            "required": ["method", "url", "body"],
            "properties": {
              "method": { "type": "string", "example": "POST" },
              "url": { "type": "string" },
              "body": {
                "type": "object",
                "properties": {
                  "type": { "type": "string", "example": "json" },
                  "value": {
                    "type": "object",
                    "description": "Core payload: ds uses key+params; fr uses formId+data"
                  }
                }
              },
              "tls": {
                "type": "object",
                "properties": {
                  "verifyCertificate": { "type": "boolean", "default": true }
                }
              }
            }
          }
        }
      },
      "RuntimeExecuteRequest": {
        "type": "object",
        "required": ["projectKey", "runtimeProfileId"],
        "properties": {
          "projectKey": { "type": "string", "description": "CDE applicationId / project key" },
          "runtimeProfileId": { "type": "string" },
          "input": {
            "type": "object",
            "description": "Business params (ds) or data object (fr); omit for empty payload",
            "additionalProperties": true
          },
          "confirmed": {
            "type": "boolean",
            "description": "Required true for CORE_COMMAND (fr/) execution"
          },
          "expectedProjectServiceId": {
            "type": "string",
            "description": "Optional guard when synced requests must match approved service id"
          },
          "businessJustification": {
            "type": "string",
            "description": "Required for Production Core Commands"
          },
          "requestId": { "type": "string" }
        }
      }
    }
  }
}
