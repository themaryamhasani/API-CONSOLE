        "tags": ["discovery"], "summary": "Idempotently sync selected discovered operations to a Collection",
        "parameters": [{ "name": "projectKey", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "snapshotId", "in": "path", "required": true, "schema": { "type": "string" } }, { "name": "x-csrf-token", "in": "header", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Created, updated, unchanged, conflict and stale results" } }
      }
    },
    "/api/api-console/runtime/operations/{operationId}/execute": {
      "post": {
        "tags": ["runtime"],
        "summary": "Execute a discovered ds/fr operation through the secure Runtime proxy",
        "description": "Use operationId from GET .../discovery/latest. ds/ maps to get-data-source; fr/ maps to store-form-data. Core Commands require confirmed=true.",
        "parameters": [
          { "name": "operationId", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Discovery operation id (not the ds/fr path itself)" },
          { "name": "x-csrf-token", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RuntimeExecuteRequest" },
              "examples": {
                "ds-community-list": {
                  "summary": "Execute ds/community/list",
                  "value": {
                    "projectKey": "YOUR_PROJECT_KEY",
                    "runtimeProfileId": "YOUR_RUNTIME_PROFILE_ID",
                    "input": { "page": 1 }
                  }
                },
                "fr-community-save": {
                  "summary": "Execute fr/community/save",
                  "value": {
                    "projectKey": "YOUR_PROJECT_KEY",
                    "runtimeProfileId": "YOUR_RUNTIME_PROFILE_ID",
                    "confirmed": true,
                    "input": { "title": "example" }
                  }
                }
              }
            }
          }
        },
        "responses": { "200": { "description": "Sanitized execution result" }, "401": { "description": "Runtime session required" }, "409": { "description": "Profile or confirmation incomplete" } }
      }
    },
