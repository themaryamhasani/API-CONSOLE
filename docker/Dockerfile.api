# syntax=docker/dockerfile:1
# Build from repo root — plain docker build (not compose):
#   docker build -f docker/Dockerfile.api -t api-console-api:latest .
#   npm run docker:build
#
# Requires outbound HTTPS from Docker to:
#   - registry.npmjs.org  (npm ci)
#   - binaries.prisma.sh  (prisma generate)
#
# Run via docker-compose.yml (image tag only; no build; external DATABASE_URL).
# Avoid apt-get (corporate/restricted networks often block deb.debian.org).

FROM node:22-bookworm-slim AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
# Workspaces hoist packages to /app/node_modules (do NOT copy apps/api/node_modules).
# ignore-scripts avoids Prisma postinstall hang when CDN is flaky; generate in runtime stage.
RUN npm ci --workspace=@api-console/api --include-workspace-root --ignore-scripts

FROM node:22-bookworm-slim AS runtime
ENV NODE_ENV=production
ENV API_CONSOLE_PORT=5281
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/
COPY apps/api/prisma apps/api/prisma
COPY apps/api/src apps/api/src
COPY apps/api/bin apps/api/bin
COPY scripts scripts
COPY docker/api-entrypoint.sh /usr/local/bin/api-entrypoint.sh
RUN node -e "const fs=require('fs');const p='/usr/local/bin/api-entrypoint.sh';fs.writeFileSync(p,fs.readFileSync(p,'utf8').replace(/\r\n/g,'\n'))" \
  && chmod +x /usr/local/bin/api-entrypoint.sh \
  && npm run db:generate -w @api-console/api \
  && mkdir -p /app/runtime/api-console

EXPOSE 5281
HEALTHCHECK --interval=15s --timeout=5s --start-period=60s --retries=8 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.API_CONSOLE_PORT||5281)+'/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

ENTRYPOINT ["/usr/local/bin/api-entrypoint.sh"]
CMD ["node", "apps/api/src/main.cjs"]
